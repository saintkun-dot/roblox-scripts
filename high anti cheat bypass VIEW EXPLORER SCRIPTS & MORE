local activeSelectedInstance = nil

local function showProperties(inst)
	activeSelectedInstance = inst
	for _, child in ipairs(propScroll:GetChildren()) do
		if child:IsA("Frame") then child:Destroy() end
	end
	
	if not inst then return end
	
	local commonProps = {"Name", "ClassName", "Parent"}
	if inst:IsA("BasePart") then
		table.insert(commonProps, "Position")
		table.insert(commonProps, "Size")
		table.insert(commonProps, "BrickColor")
		table.insert(commonProps, "Transparency")
		table.insert(commonProps, "Anchored")
		table.insert(commonProps, "CanCollide")
	elseif inst:IsA("Model") then
		table.insert(commonProps, "WorldPivot")
	elseif inst:IsA("GuiObject") then
		table.insert(commonProps, "Size")
		table.insert(commonProps, "Position")
		table.insert(commonProps, "BackgroundColor3")
		table.insert(commonProps, "Visible")
	end
	
	for _, propName in ipairs(commonProps) do
		local success, val = pcall(function() return inst[propName] end)
		if success then
			local row = Instance.new("Frame")
			row.Size = UDim2.new(1, -4, 0, 28)
			row.BackgroundTransparency = 1
			row.ZIndex = 7
			row.Parent = propScroll
			
			local label = Instance.new("TextLabel")
			label.Size = UDim2.new(0.4, 0, 1, 0)
			label.Position = UDim2.new(0, 6, 0, 0)
			label.BackgroundTransparency = 1
			label.Text = propName
			label.TextColor3 = COLOR_SUBTEXT
			label.Font = Enum.Font.GothamBold
			label.TextSize = 11
			label.TextXAlignment = Enum.TextXAlignment.Left
			label.ZIndex = 7
			label.Parent = row
			
			local valBox = Instance.new("TextBox")
			valBox.Size = UDim2.new(0.58, 0, 0, 24)
			valBox.Position = UDim2.new(0.4, 0, 0.5, -12)
			valBox.BackgroundColor3 = COLOR_BG
			valBox.Text = tostring(val)
			valBox.TextColor3 = COLOR_TEXT
			valBox.Font = Enum.Font.Gotham
			valBox.TextSize = 11
			valBox.ZIndex = 8
			valBox.Parent = row
			applyCorner(valBox, 4)
			applyStroke(valBox, COLOR_BORDER, 1)
			
			valBox.FocusLost:Connect(function()
				pcall(function()
					local newVal = valBox.Text
					if val == true or val == false then
						newVal = (newVal:lower() == "true")
					elseif tonumber(newVal) then
						newVal = tonumber(newVal)
					end
					inst[propName] = newVal
				end)
			end)
		end
	end
	propScroll.CanvasSize = UDim2.new(0, 0, 0, #commonProps * 30)
end


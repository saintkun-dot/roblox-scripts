		end
		
		local selectBtn = Instance.new("TextButton")
		selectBtn.Size = UDim2.new(1, - (indentLevel * 12) - (hasChildren and 24 or 0), 0, 24)
		selectBtn.Position = UDim2.new(0, (indentLevel * 12) + (hasChildren and 24 or 0), 0, 1)
		selectBtn.BackgroundColor3 = COLOR_BG
		selectBtn.Text = " " .. child.Name .. " (" .. child.ClassName .. ")"
		selectBtn.TextColor3 = COLOR_TEXT
		selectBtn.Font = Enum.Font.Gotham
		selectBtn.TextSize = 11
		selectBtn.TextXAlignment = Enum.TextXAlignment.Left
		selectBtn.ZIndex = 7
		selectBtn.Parent = itemRow
		applyCorner(selectBtn, 4)
		
		selectBtn.MouseButton1Click:Connect(function()
			activeSelectedInstance = child
			showProperties(child)
			
			if child.Name == "ServerScriptService" or child.Name == "ServerStorage" then
				viewerBox.Text = "-- unable to see scripts here cant bypass sorryy --"
			elseif child:IsA("LuaSourceContainer") then
				local success, src = pcall(function()
					return getscriptsource and getscriptsource(child) or child.Source
				end)
				if success and src then
					viewerBox.Text = src
				else
					viewerBox.Text = "-- unable to see scripts here cant bypass sorryy --"
				end
			else
				viewerBox.Text = "--- Children Summary ---\n"
				for _, c in ipairs(child:GetChildren()) do
					viewerBox.Text = viewerBox.Text .. "• " .. c.Name .. " (" .. c.ClassName .. ")\n"
				end
			end
		end)
		
		if hasChildren then
			local childContainer = Instance.new("Frame")
			childContainer.Name = "ChildContainer"
			childContainer.Size = UDim2.new(1, 0, 0, 0)
			childContainer.BackgroundTransparency = 1
			childContainer.Visible = false
			childContainer.AutomaticSize = Enum.AutomaticSize.Y
			childContainer.ZIndex = 6
			childContainer.Parent = parentGuiContainer
			
			local subLayout = Instance.new("UIListLayout")
			subLayout.SortOrder = Enum.SortOrder.LayoutOrder
			subLayout.Padding = UDim.new(0, 2)
			subLayout.Parent = childContainer
			
			local isExpanded = false
			expandBtn.MouseButton1Click:Connect(function()
				isExpanded = not isExpanded
				childContainer.Visible = isExpanded
				expandBtn.Text = isExpanded and "▼" or "▶"
				if isExpanded and #childContainer:GetChildren() <= 1 then
					buildSubTree(child, childContainer, indentLevel + 1)
				end
				updateCanvasSize()
			end)
		end
	end
	updateCanvasSize()
end

updateCanvasSize = function()
	local function calculateHeight(container)
		local h = 0
		for _, item in ipairs(container:GetChildren()) do
			if item:IsA("Frame") then
				h = h + 28
				local childCont = item:FindFirstChild("ChildContainer")
				if childCont and childCont.Visible then
					h = h + calculateHeight(childCont)
				end
			end
		end
		return h
	end
	treeScroll.CanvasSize = UDim2.new(0, 0, 0, calculateHeight(treeScroll) + 40)
end

